#!/usr/bin/env bash
# log-analyzer.sh: log fayldagi eng ko'p uchragan IP manzillarni topadi
# Ishlatish: ./log-analyzer.sh access.log [N]

set -euo pipefail

LOG_FILE="${1:-}"
TOP_N="${2:-10}"

if [[ -z "$LOG_FILE" ]]; then
    echo "Ishlatish: $0 <log_fayl> [top_soni]" >&2
    exit 1
fi

if [[ ! -f "$LOG_FILE" ]]; then
    echo "Xato: '$LOG_FILE' fayli topilmadi" >&2
    exit 1
fi

echo "=== Eng ko'p so'rov yuborgan ${TOP_N} ta IP ==="
grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' "$LOG_FILE" \
    | sort \
    | uniq -c \
    | sort -rn \
    | head -n "$TOP_N"
clay@WIN-FQ5C66A1RDV:~/cybersecurity-journey/bash$
